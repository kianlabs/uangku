# ==============================================================================
# Uangku - Docker Compose Environment Configuration
# Copy this file to .env before running: docker compose up -d
# ==============================================================================

# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=uangku
POSTGRES_PORT=5432

# Backend (FastAPI) Configuration
APP_ENV=development
# DEV ONLY. Nilai ini DITOLAK saat APP_ENV=production.
# Generate untuk produksi: openssl rand -hex 32
SECRET_KEY=uangku-dev-secret-key-change-in-production-min-32-chars
HTTPS_ONLY=false
INVITE_CODE=
TRUSTED_PROXY_IPS=127.0.0.1
# WAJIB di production: origin frontend yang diizinkan (CSRF).
# Contoh: ALLOWED_ORIGINS=https://uangku-web.my.id
ALLOWED_ORIGINS=
RUN_MIGRATIONS=true
WEB_CONCURRENCY=2
BACKEND_PORT=8000

# Optional Third-Party Integrations
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GEMINI_API_KEY=

# Frontend (Next.js) Configuration
FRONTEND_PORT=3000
SERVER_URL=http://server:8000
