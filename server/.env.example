# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/uangku
DATABASE_URL_TEST=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/uangku_test
# Required in production (APP_ENV=production refuses the default below).
SECRET_KEY=ganti-dengan-string-acak-min-32-karakter
# Must be true in production (enforced) so session cookies never go over HTTP.
HTTPS_ONLY=false
# Comma-separated IPs of trusted reverse proxies (e.g. "10.0.0.1,10.0.0.2").
# Only requests from these IPs may use X-Forwarded-For for rate-limit IP detection.
# Proxy lokal (127.0.0.1/::1, mis. Next rewrite satu container) selalu dipercaya.
TRUSTED_PROXY_IPS=
# Kode undangan registrasi (production lingkup keluarga). Kosong = terbuka.
INVITE_CODE=
APP_ENV=development

# Google OAuth 2.0 (Login dengan Google)
# Dapatkan dari Google Cloud Console -> APIs & Services -> Credentials -> OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Opsional: override redirect URI jika diperlukan (default: otomatis dari host request)
GOOGLE_REDIRECT_URI=
