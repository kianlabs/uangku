# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/uangku
DATABASE_URL_TEST=postgresql+psycopg://postgres:postgres@localhost:5432/uangku_test
# Required in production (APP_ENV=production refuses the default below).
SECRET_KEY=ganti-dengan-string-acak-min-32-karakter
# Must be true in production (enforced) so session cookies never go over HTTP.
HTTPS_ONLY=false
# Frontend rewrite target (server-side only, never exposed to the browser).
BACKEND_URL=http://localhost:8000
APP_ENV=development
